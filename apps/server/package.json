{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- npx --yes auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@bts-scaffold2/api": "*",
    "@bts-scaffold2/auth": "*",
    "@bts-scaffold2/db": "*",
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "^11.19.0",
    "better-auth": "1.7.10",
    "hono": "^4.13.7",
    "libsql": "0.5.29",
    "varlock": "1.18.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@bts-scaffold2/config": "*",
    "@types/bun": "^1.4.3",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  }
}
